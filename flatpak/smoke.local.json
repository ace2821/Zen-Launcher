{
  "app-id": "io.github.ace2821.ZincLauncher",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "zinc-launcher",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.node24"
  ],
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--share=network",
    "--socket=pulseaudio",
    "--device=dri",
    "--device=all",
    "--filesystem=/run/media:ro",
    "--filesystem=/mnt:ro",
    "--filesystem=~/Games:rw",
    "--filesystem=~/.local/share/Steam:ro",
    "--filesystem=~/.steam/steam:ro",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=com.feralinteractive.GameMode",
    "--env=WEBKIT_DISABLE_DMABUF_RENDERER=1"
  ],
  "modules": [
    {
      "name": "zinc-launcher",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/node24/bin",
        "env": {
          "CARGO_HOME": "/run/build/zinc-launcher/cargo",
          "CARGO_NET_OFFLINE": "true",
          "XDG_CACHE_HOME": "/run/build/zinc-launcher/flatpak-node/cache",
          "npm_config_cache": "/run/build/zinc-launcher/flatpak-node/npm-cache"
        }
      },
      "build-commands": [
        "npm ci --offline",
        "npm run build",
        "cargo build --release --offline --manifest-path src-tauri/Cargo.toml",
        "install -Dm0755 src-tauri/target/release/zinc-launcher ${FLATPAK_DEST}/bin/zinc-launcher",
        "install -Dm0644 io.github.ace2821.ZincLauncher.desktop ${FLATPAK_DEST}/share/applications/io.github.ace2821.ZincLauncher.desktop",
        "install -Dm0644 io.github.ace2821.ZincLauncher.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.ace2821.ZincLauncher.metainfo.xml",
        "install -Dm0644 src-tauri/icons/128x128.png ${FLATPAK_DEST}/share/icons/hicolor/128x128/apps/io.github.ace2821.ZincLauncher.png",
        "install -Dm0644 src-tauri/icons/128x128@2x.png ${FLATPAK_DEST}/share/icons/hicolor/256x256/apps/io.github.ace2821.ZincLauncher.png",
        "install -Dm0644 src-tauri/icons/icon.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/io.github.ace2821.ZincLauncher.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            "node_modules",
            "dist",
            "src-tauri/target"
          ]
        },
        "cargo-sources.json",
        "node-sources.json"
      ]
    }
  ]
}
