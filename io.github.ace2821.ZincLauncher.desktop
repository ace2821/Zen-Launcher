[Desktop Entry]
Name=Zinc Launcher
Comment=Local-first game library manager and launcher
Exec=zinc-launcher %u
Icon=io.github.ace2821.ZincLauncher
Terminal=false
Type=Application
Categories=Game;Utility;
Keywords=game;launcher;library;mods;wine;big picture;
StartupNotify=true
StartupWMClass=zinc-launcher
MimeType=x-scheme-handler/zinclaucher;
X-Scheme-Handler=zinclaucher;
