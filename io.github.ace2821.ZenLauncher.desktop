[Desktop Entry]
Name=Zen Launcher
Comment=Local-first game library manager and launcher
Exec=zen-launcher %u
Icon=io.github.ace2821.ZenLauncher
Terminal=false
Type=Application
Categories=Game;Utility;
Keywords=game;launcher;library;mods;wine;big picture;
StartupNotify=true
StartupWMClass=zen-launcher
MimeType=x-scheme-handler/zenlauncher;
X-Scheme-Handler=zenlauncher;
